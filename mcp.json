{
  "mcpServers": {
    "hashkey-compliance-monitor-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "HACKATHON_TRACK": "HashKey Chain",
        "PROJECT_TICKER": "HKCOMP"
      },
      "tools": [
        {
          "name": "verify_hkcomp_invariants",
          "description": "Verifies deterministic invariants for HashKey Compliance Monitor AI on HashKey Chain."
        },
        {
          "name": "execute_hkcomp_action",
          "description": "Executes authenticated Compliance state transition."
        }
      ]
    }
  }
}